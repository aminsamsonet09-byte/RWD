{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "linux-dev",
      "displayName": "Linux development (unit tests + dev bundle)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/Builds/linux-dev",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "linux-asan",
      "displayName": "Linux Debug + ASan/UBSan",
      "inherits": "linux-dev",
      "binaryDir": "${sourceDir}/Builds/linux-asan",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "RWD_SANITIZE": "ON", "RWD_WARNINGS_AS_ERRORS": "ON" }
    },
    {
      "name": "windows-msvc-x64",
      "displayName": "Windows 10/11 x64 (Visual Studio 2022)",
      "generator": "Visual Studio 17 2022",
      "architecture": { "value": "x64", "strategy": "set" },
      "binaryDir": "${sourceDir}/Builds/windows-x64",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "macos-universal",
      "displayName": "macOS universal (arm64 + x86_64)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/Builds/macos-universal",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
    },
    {
      "name": "macos-arm64",
      "displayName": "macOS Apple Silicon only (arm64)",
      "inherits": "macos-universal",
      "binaryDir": "${sourceDir}/Builds/macos-arm64",
      "cacheVariables": { "CMAKE_OSX_ARCHITECTURES": "arm64" }
    },
    {
      "name": "macos-x86_64",
      "displayName": "macOS Intel only (x86_64)",
      "inherits": "macos-universal",
      "binaryDir": "${sourceDir}/Builds/macos-x86_64",
      "cacheVariables": { "CMAKE_OSX_ARCHITECTURES": "x86_64" }
    }
  ],
  "buildPresets": [
    { "name": "linux-dev", "configurePreset": "linux-dev" },
    { "name": "linux-asan", "configurePreset": "linux-asan" },
    { "name": "windows-msvc-x64", "configurePreset": "windows-msvc-x64", "configuration": "Release" },
    { "name": "macos-universal", "configurePreset": "macos-universal" },
    { "name": "macos-arm64", "configurePreset": "macos-arm64" },
    { "name": "macos-x86_64", "configurePreset": "macos-x86_64" }
  ],
  "testPresets": [
    { "name": "linux-dev", "configurePreset": "linux-dev", "output": { "outputOnFailure": true } },
    { "name": "linux-asan", "configurePreset": "linux-asan", "output": { "outputOnFailure": true } },
    { "name": "windows-msvc-x64", "configurePreset": "windows-msvc-x64", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "macos-universal", "configurePreset": "macos-universal", "output": { "outputOnFailure": true } },
    { "name": "macos-arm64", "configurePreset": "macos-arm64", "output": { "outputOnFailure": true } },
    { "name": "macos-x86_64", "configurePreset": "macos-x86_64", "output": { "outputOnFailure": true } }
  ]
}
